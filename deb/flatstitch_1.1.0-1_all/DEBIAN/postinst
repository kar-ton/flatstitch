#!/bin/bash
set -e

APP_DIR=/opt/flatstitch
VENV_DIR="$APP_DIR/venv"

case "$1" in
  configure)
    echo "flatstitch: налаштування ізольованого середовища Python..."
    echo "flatstitch: це разова дія, потрібне інтернет-з'єднання, може тривати кілька хвилин."

    rm -rf "$VENV_DIR"
    if ! python3 -m venv "$VENV_DIR"; then
        echo "flatstitch: ПОМИЛКА - не вдалося створити venv. Перевірте, що встановлено python3-venv." >&2
        exit 1
    fi

    # dpkg/apt run maintainer scripts with a minimal environment, so a
    # proxy exported in your own shell is NOT visible here even with
    # `sudo -E`. If http_proxy/https_proxy aren't already set, fall back
    # to whatever apt itself is configured to use, if anything.
    if [ -z "$http_proxy" ] && [ -z "$https_proxy" ] && command -v apt-config >/dev/null 2>&1; then
        APT_PROXY=$(apt-config shell APT_PROXY Acquire::http::Proxy 2>/dev/null | sed -e "s/^APT_PROXY='//" -e "s/'$//")
        if [ -n "$APT_PROXY" ]; then
            export http_proxy="$APT_PROXY"
            export https_proxy="$APT_PROXY"
            echo "flatstitch: використовую проксі з налаштувань apt: $APT_PROXY"
        fi
    fi

    # Upgrading pip itself is a nice-to-have - never let its failure
    # (e.g. no network route) abort the rest of this script.
    "$VENV_DIR/bin/pip" install --quiet --upgrade pip || true

    INSTALL_OK=1
    if ! "$VENV_DIR/bin/pip" install --quiet -r "$APP_DIR/requirements.txt"; then
        INSTALL_OK=0
    fi

    if [ "$INSTALL_OK" -eq 0 ]; then
        cat >&2 << 'EOM'
flatstitch: ПОПЕРЕДЖЕННЯ - не вдалося встановити частину Python-залежностей.
  Найчастіша причина - відсутній або неналаштований доступ до інтернету
  (наприклад, робота через проксі, який не видно з postinst-скрипта).
  Встановіть залежності вручну однією командою (підставте свій проксі,
  якщо він є):

    sudo http_proxy=http://ХОСТ:ПОРТ https_proxy=http://ХОСТ:ПОРТ \
        /opt/flatstitch/venv/bin/pip install -r /opt/flatstitch/requirements.txt

  Без проксі (якщо доступ до інтернету є напряму):

    sudo /opt/flatstitch/venv/bin/pip install -r /opt/flatstitch/requirements.txt

  flatstitch встановлено, але не запрацює, доки це не буде виконано.
EOM
    else
        echo "flatstitch: залежності встановлено успішно."
    fi

    # Force-refresh icon/menu caches so the real icon (not a generic
    # placeholder) and the menu entry show up without waiting for some
    # unrelated future cache invalidation. Some desktop shells (Cinnamon
    # included) still only pick up a BRAND NEW .desktop entry on their
    # next restart/login even after this - that part is normal and not
    # something a postinst script can force from the outside.
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -f -t /usr/share/icons/hicolor || true
    fi
    if command -v xdg-desktop-menu >/dev/null 2>&1; then
        xdg-desktop-menu forceupdate || true
    fi
    ;;
esac

exit 0
